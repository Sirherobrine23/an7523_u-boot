menu "Airoha MIPS platforms"
	depends on ARCH_ECONET

config TARGET_EN751221
	bool "Airoha EN751221 SoC"
	select SYSCON
	select MIPS_TUNE_34KC

config TARGET_EN7528
	bool "Airoha EN7528 SoC"
	select SYSCON
	select MIPS_TUNE_1004KC
	select MIPS_SKIP_CP0_COUNT_CLEAR

config SYS_VENDOR
	default "econet"

config SYS_SOC
	default "en751221" if TARGET_EN751221
	default "en7528" if TARGET_EN7528

config SYS_BOARD
	default "en7512" if TARGET_EN751221
	default "en7528" if TARGET_EN7528

config SYS_CONFIG_NAME
	default "en7512" if TARGET_EN751221
	default "en7528" if TARGET_EN7528

config SYS_MALLOC_F_LEN
	default 0x2000

config SYS_DCACHE_SIZE
	default 32768

config SYS_DCACHE_LINE_SIZE
	default 32

config SYS_ICACHE_SIZE
	default 32768

config SYS_ICACHE_LINE_SIZE
	default 32

config TEXT_BASE
	default 0x81000000

config SPL_TEXT_BASE
	default 0x80010000

config SPL_SIZE_LIMIT
	default 0x30000

config TPL_TEXT_BASE
	default 0xbfc00000

config TPL_MAX_SIZE
	default 0x8000


config BUILD_TARGET
	default "u-boot.img" if TARGET_EN751221

config BOARD_EN7512_REFERENCE
	bool "EN7512/EN7521 reference board"
	select TARGET_EN751221
	select BINMAN
	select SPL_LOADER_SUPPORT if SPL
	help
	  Build a boot image compatible with the EN7512/EN7521 TCBoot flow.
	  TPL initializes the serial flash controller, executes the legacy DDR
	  calibration stage from FE SRAM and loads SPL into DDR.

config BOARD_EN7528_TPLINK_XC220_G3V
	bool "TP-Link XC220-G3V (EN7528, chainloaded)"
	select TARGET_EN7528
	help
	  Build U-Boot proper for the TP-Link XC220-G3V. This target assumes a
	  previous boot stage has initialized DDR and the integrated switch PHYs.
	  It intentionally produces a plain u-boot.bin for one-time serial loading,
	  after which Ethernet/TFTP and the 16 MiB SPI-NOR can be used.

config BOARD_EN7528_REFERENCE
	bool "EcoNet EN7528 reference board (DASAN H660GM-A)"
	select TARGET_EN7528
	help
	  Build U-Boot proper for the EcoNet EN7528 reference board, as found
	  on the DASAN H660GM-A.  Like the XC220-G3V it is chainloaded after a
	  previous stage has trained DDR, but boots from SPI-NAND.

endmenu
