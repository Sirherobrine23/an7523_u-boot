menu "EcoNet/Airoha EN75xx platforms"
	depends on ARCH_EN75XX

config SYS_VENDOR
	default "econet"

config SYS_SOC
	default "en7528" if BOARD_EN7528_TPLINK_XC220_G3V
	default "en7512"

config SYS_BOARD
	default "en7528" if BOARD_EN7528_TPLINK_XC220_G3V
	default "en7512"

config SYS_CONFIG_NAME
	default "en7528" if BOARD_EN7528_TPLINK_XC220_G3V
	default "en7512"

config SYS_MALLOC_F_LEN
	default 0x2000

config EN75XX_SCU
	bool "EcoNet/Airoha EN75xx SCU clock/reset controller"
	default y if BOARD_EN7528_TPLINK_XC220_G3V
	select CLK
	select DM_RESET
	select REGMAP
	select RESET_AIROHA
	help
	  Enable the EN75xx System Control Unit regmap helpers together with
	  the Airoha clock and reset-controller drivers.  EN7528 shares the
	  EN7523 SCU reset layout.

config SYS_DCACHE_SIZE
	default 32768

config SYS_DCACHE_LINE_SIZE
	default 32

config SYS_ICACHE_SIZE
	default 32768

config SYS_ICACHE_LINE_SIZE
	default 32

config TEXT_BASE
	default 0x81000000

config SPL_TEXT_BASE
	default 0x80010000

config SPL_SIZE_LIMIT
	default 0x30000

config TPL_TEXT_BASE
	default 0xbfc00000

config TPL_MAX_SIZE
	default 0x8000


config BUILD_TARGET
	default "u-boot.img" if BOARD_EN7512_REFERENCE

config BOARD_EN7512_REFERENCE
	bool "EN7512/EN7521 reference board"
	select BINMAN
	select SPL_LOADER_SUPPORT if SPL
	help
	  Build a boot image compatible with the EN7512/EN7521 TCBoot flow.
	  TPL initializes the serial flash controller, executes the legacy DDR
	  calibration stage from FE SRAM and loads SPL into DDR.

config BOARD_EN7528_TPLINK_XC220_G3V
	bool "TP-Link XC220-G3V (EN7528, chainloaded)"
	help
	  Build U-Boot proper for the TP-Link XC220-G3V. This target assumes a
	  previous boot stage has initialized DDR and the integrated switch PHYs.
	  It intentionally produces a plain u-boot.bin for one-time serial loading,
	  after which Ethernet/TFTP and the 16 MiB SPI-NOR can be used.

endmenu
