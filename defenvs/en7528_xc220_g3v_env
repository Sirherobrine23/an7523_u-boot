bootfile=openwrt-airoha-en7528-tplink_xc220_g3v-initramfs-kernel.bin
ipaddr=192.168.1.1
serverip=192.168.1.2
loadaddr=0x82000000
load_initramfs=tftpboot ${loadaddr} ${bootfile}
netboot=run load_initramfs; bootm ${loadaddr}
sfprobe=sf probe 0:0 25000000
stockboot=run sfprobe; sf read ${loadaddr} 0x50000 0x220000; bootm ${loadaddr}
mtdids=nor0=spi0.0
mtdparts=mtdparts=spi0.0:0x40000(boot)ro,0x10000(romfile),0x220000(kernel),0xcd0000(rootfs),0xc0000(misc)
bootcmd=run netboot
